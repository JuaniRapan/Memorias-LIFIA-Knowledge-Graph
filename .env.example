# Copiar este archivo a .env y ajustar si hace
# falta. Estos son los valores por defecto que usa docker/docker-compose.yml,
# así que levantando el stack con esos defaults ya funciona.

# --- Postgres (src/etl/extract.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifia_db
DB_USER=postgres
DB_PASSWORD=secret

# --- Kafka (src/streaming/stream_consumer.py) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- GraphDB (src/etl/load_to_graphdb.py, src/streaming/graphdb_client.py) ---
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=memorias-lifia
